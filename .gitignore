# Local user data — SQLite database and anything else under data/ must never be committed.
/data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Backend build output
backend/target/

# Frontend build output / deps (D-04)
frontend/node_modules/
frontend/dist/
*.tsbuildinfo
*.log
*.log.*
*.db-*
*.sqlite-*
*.sqlite3-*
*.pem
*.key
*.p12
*.jks

# Stable local-service artifacts generated by scripts/macos/install.command
/.runtime/

# Local environment overrides
.env
.env.*
!.env.example

# IDE / OS
.idea/
*.iml
.vscode/
.DS_Store
